# Real input data — never committed (see README's "Data expected on disk").
# Everyone provides their own copies locally, matching configs/regions/*.yaml.
/data/

# Generated products — regenerated by the CLI workflows / API, not source.
/outputs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
build/
dist/

# Frontend (frontend/ has its own .gitignore too; these cover a repo-root run)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Local Claude Code runtime state (lock files etc.), not project config
.claude/
